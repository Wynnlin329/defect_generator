# Every VITE_* value is embedded in the browser bundle and must be treated as public.
# Copy this file to .env.local and replace the reserved example domains locally.
# Never add passwords, access tokens, API keys, or confidential client secrets here.

VITE_AUTH_BASE_URL=https://auth.example.invalid/gdai/v1
VITE_ALGORITHM_API_BASE_URL=https://algorithm.example.invalid/gdai/v1/api
VITE_PROJECT_API_BASE_URL=https://project.example.invalid/api

# Required explicit boolean. Keep true unless a reviewed environment should call the project API.
VITE_USE_PROJECT_TEST_DATA=true

# Optional public OAuth client identifier. Do not use this for a confidential client secret.
VITE_OAUTH_CLIENT_ID=
